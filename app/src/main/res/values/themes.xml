<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Starting Theme applied during app launch before Activity is drawn -->
    <style name="Theme.App.Starting" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#FAF7F2</item>
        <item name="android:navigationBarColor">#FAF7F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Main Application Theme once Compose takes over -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#FAF7F2</item>
        <item name="android:statusBarColor">#FAF7F2</item>
        <item name="android:navigationBarColor">#FAF7F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
